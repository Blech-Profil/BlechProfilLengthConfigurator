<div class="blechprofil-length-configurator card mb-3"
     data-blechprofil-length-configurator
     data-activation-property-id="{{ activationPropertyId }}"
     data-activation-selection-id="{{ activationSelectionId }}"
     data-min-length="{{ minLength }}"
     data-max-length="{{ maxLength }}"
     data-saw-kerf="{{ sawKerf }}"
     hidden
     style="display:none !important;">
    <div class="card-body">
        <strong class="d-block mb-2">Wunschlänge konfigurieren</strong>

        <div class="form-row align-items-end">
            <div class="form-group col-sm-7 mb-2">
                <label>Wunschlänge in mm</label>
                <input
                    class="form-control"
                    type="number"
                    min="{{ minLength }}"
                    max="{{ maxLength }}"
                    step="1"
                    placeholder="z. B. 1268"
                    data-bp-length-input>
                <small class="form-text text-muted">{{ minLength }} bis {{ maxLength }} mm, Sägeschnitt aktuell {{ sawKerf }} mm.</small>
            </div>

            <div class="form-group col-sm-5 mb-2">
                <label>Menge</label>
                <input
                    class="form-control"
                    type="number"
                    min="1"
                    step="1"
                    value="1"
                    data-bp-quantity-input>
            </div>
        </div>

        <button type="button" class="btn btn-outline-secondary btn-block mb-2" data-bp-check-button>
            Passende Lagerlänge prüfen
        </button>

        <div class="alert alert-light border mb-2 d-none" data-bp-result></div>

        <button type="button" class="btn btn-primary btn-block d-none" data-bp-add-button>
            Wunschlänge in den Warenkorb
        </button>
    </div>
</div>

<div class="alert alert-warning mb-3 d-none"
     data-bp-diagnostic
     style="font-size:0.875rem; white-space:pre-wrap;"></div>

<script>
(function () {
    var script = document.currentScript;
    var diagnostic = script ? script.previousElementSibling : null;
    var root = diagnostic ? diagnostic.previousElementSibling : null;

    if (!root || !root.hasAttribute('data-blechprofil-length-configurator')) {
        var roots = document.querySelectorAll('[data-blechprofil-length-configurator]');
        root = roots.length ? roots[roots.length - 1] : null;
    }
    if (!diagnostic || !diagnostic.hasAttribute('data-bp-diagnostic')) {
        var diagnostics = document.querySelectorAll('[data-bp-diagnostic]');
        diagnostic = diagnostics.length ? diagnostics[diagnostics.length - 1] : null;
    }
    if (!root || root.getAttribute('data-bp-booted') === '1') return;
    root.setAttribute('data-bp-booted', '1');

    var lengthInput = root.querySelector('[data-bp-length-input]');
    var quantityInput = root.querySelector('[data-bp-quantity-input]');
    var checkButton = root.querySelector('[data-bp-check-button]');
    var addButton = root.querySelector('[data-bp-add-button]');
    var resultBox = root.querySelector('[data-bp-result]');
    var lastCheckedVariationId = 0;
    var eligibilityRequestNo = 0;
    var debugMode = /(?:\?|&)bpdebug=1(?:&|$)/.test(window.location.search);

    function toInt(value) {
        var parsed = parseInt(value || '0', 10);
        return isNaN(parsed) ? 0 : parsed;
    }

    function parseIdsFromPath() {
        var match = window.location.pathname.match(/_(\d+)_(\d+)(?:\/)?$/);
        return match ? { itemId: toInt(match[1]), variationId: toInt(match[2]) } : { itemId: 0, variationId: 0 };
    }

    function readStoreIds(ids) {
        var stores = [];

        try {
            if (window.ceresStore && window.ceresStore.state) stores.push(window.ceresStore);
        } catch (e) {}

        try {
            if (window.vueApp && window.vueApp.$store && window.vueApp.$store.state) stores.push(window.vueApp.$store);
        } catch (e) {}

        for (var i = 0; i < stores.length; i++) {
            try {
                var state = stores[i].state;
                if (!state || !state.items || !ids.itemId || !state.items[ids.itemId]) continue;

                var itemState = state.items[ids.itemId];
                var candidates = [
                    itemState.variation,
                    itemState.currentVariation,
                    itemState.selectedVariation
                ];

                for (var c = 0; c < candidates.length; c++) {
                    var candidate = candidates[c];
                    if (!candidate) continue;

                    if (candidate.id) ids.variationId = toInt(candidate.id);

                    if (
                        candidate.documents && candidate.documents[0] && candidate.documents[0].data
                    ) {
                        var data = candidate.documents[0].data;
                        if (data.item && data.item.id) ids.itemId = toInt(data.item.id);
                        if (data.variation && data.variation.id) ids.variationId = toInt(data.variation.id);
                    }
                }
            } catch (e) {}
        }

        return ids;
    }

    function getCurrentIds() {
        return readStoreIds(parseIdsFromPath());
    }

    function setVisible(visible) {
        if (visible) {
            root.hidden = false;
            root.style.removeProperty('display');
        } else {
            root.hidden = true;
            root.style.setProperty('display', 'none', 'important');
            addButton.classList.add('d-none');
            resultBox.classList.add('d-none');
        }
    }

    function showDiagnostic(text, isError) {
        if (!debugMode || !diagnostic) return;
        diagnostic.classList.remove('d-none', 'alert-warning', 'alert-danger', 'alert-success');
        diagnostic.classList.add(isError ? 'alert-danger' : 'alert-warning');
        diagnostic.textContent = text;
    }

    function hideDiagnostic() {
        if (diagnostic && !debugMode) diagnostic.classList.add('d-none');
    }

    function responseAsJson(response) {
        return response.text().then(function (text) {
            var json = null;
            try { json = JSON.parse(text); } catch (e) {}

            if (!response.ok) {
                throw new Error('HTTP ' + response.status + ': ' + (json && json.message ? json.message : text.substring(0, 500)));
            }
            if (!json) {
                throw new Error('Ungültige Serverantwort: ' + text.substring(0, 500));
            }
            return json;
        });
    }

    function checkEligibility(force) {
        var ids = getCurrentIds();
        var propertyId = toInt(root.getAttribute('data-activation-property-id'));
        var selectionId = toInt(root.getAttribute('data-activation-selection-id'));

        if (!ids.itemId || !ids.variationId || !propertyId || !selectionId) {
            setVisible(false);
            showDiagnostic(
                'Alpha 0.2.0 Diagnose\n' +
                'IDs konnten nicht vollständig ermittelt werden.\n' +
                'Artikel-ID: ' + ids.itemId + '\n' +
                'Varianten-ID: ' + ids.variationId + '\n' +
                'Eigenschaft: ' + propertyId + '\n' +
                'Ja-Auswahl: ' + selectionId,
                true
            );
            return;
        }

        if (!force && ids.variationId === lastCheckedVariationId) return;

        lastCheckedVariationId = ids.variationId;
        var requestNo = ++eligibilityRequestNo;
        setVisible(false);

        fetch('/blechprofil-length-configurator/enabled?variationId=' + encodeURIComponent(String(ids.variationId)), {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
        })
            .then(responseAsJson)
            .then(function (json) {
                if (requestNo !== eligibilityRequestNo) return;

                var diagText =
                    'Alpha 0.2.0 Diagnose\n' +
                    'Artikel-ID: ' + ids.itemId + '\n' +
                    'Varianten-ID: ' + ids.variationId + '\n' +
                    'Variantennummer: ' + (json.variationNumber || '-') + '\n' +
                    'Eigenschaft: ' + propertyId + '\n' +
                    'Ja-Auswahl: ' + selectionId + '\n' +
                    'Quelle: ' + (json.source || '-') + '\n' +
                    'Freigabe: ' + (json.enabled === true ? 'JA' : 'NEIN') + '\n' +
                    'Meldung: ' + (json.message || '-');

                showDiagnostic(diagText, json.enabled !== true);

                if (json.enabled === true) {
                    root.setAttribute('data-item-id', String(ids.itemId));
                    root.setAttribute('data-variation-id', String(ids.variationId));
                    setVisible(true);
                } else {
                    setVisible(false);
                }
            })
            .catch(function (error) {
                if (requestNo !== eligibilityRequestNo) return;
                setVisible(false);
                showDiagnostic(
                    'Alpha 0.2.0 Diagnose\n' +
                    'Artikel-ID: ' + ids.itemId + '\n' +
                    'Varianten-ID: ' + ids.variationId + '\n' +
                    'Fehler bei der Freigabeprüfung:\n' + error.message,
                    true
                );
            });
    }

    function currentValues() {
        var ids = getCurrentIds();
        return {
            itemId: ids.itemId,
            variationId: ids.variationId,
            length: toInt(lengthInput.value),
            quantity: parseFloat(quantityInput.value || '1')
        };
    }

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function showResult(html, isError) {
        resultBox.classList.remove('d-none', 'alert-light', 'alert-danger', 'alert-success');
        resultBox.classList.add(isError ? 'alert-danger' : 'alert-success');
        resultBox.innerHTML = html;
    }

    function resolveSelection() {
        var data = currentValues();
        addButton.classList.add('d-none');

        if (!data.itemId || !data.variationId) {
            showResult('Artikel- oder Varianten-ID konnte nicht ermittelt werden.', true);
            return;
        }

        if (!data.length || data.length < 1) {
            showResult('Bitte eine gültige Wunschlänge eingeben.', true);
            return;
        }

        checkButton.disabled = true;
        checkButton.textContent = 'Prüfung läuft …';

        var query = new URLSearchParams({
            itemId: String(data.itemId),
            variationId: String(data.variationId),
            length: String(data.length),
            quantity: String(data.quantity)
        });

        fetch('/blechprofil-length-configurator/resolve?' + query.toString(), {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
        })
            .then(responseAsJson)
            .then(function (json) {
                if (!json.success) throw new Error(json.message || 'Keine passende Lagerlänge gefunden.');
                var s = json.selected;
                showResult(
                    '<strong>Ausgangsvariante:</strong> ' + escapeHtml(json.sourceVariationNumber) +
                    ' (ID ' + json.sourceVariationId + ')' +
                    '<br><strong>Passende Lagerlänge:</strong> ' + escapeHtml(s.variationNumber) +
                    ' (ID ' + s.variationId + ')' +
                    '<br>Rohlänge: ' + s.rawLength + ' mm' +
                    '<br>Rechnerischer Rest je Stück: ' + s.restPerPiece + ' mm',
                    false
                );
                addButton.classList.remove('d-none');
            })
            .catch(function (error) {
                showResult(escapeHtml(error.message), true);
            })
            .then(function () {
                checkButton.disabled = false;
                checkButton.textContent = 'Passende Lagerlänge prüfen';
            });
    }

    function addToBasket() {
        var data = currentValues();
        addButton.disabled = true;
        addButton.textContent = 'Wird hinzugefügt …';

        var form = new URLSearchParams();
        form.append('itemId', String(data.itemId));
        form.append('variationId', String(data.variationId));
        form.append('length', String(data.length));
        form.append('quantity', String(data.quantity));

        fetch('/blechprofil-length-configurator/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
            },
            body: form.toString()
        })
            .then(responseAsJson)
            .then(function (json) {
                if (!json.success) throw new Error(json.message || 'Warenkorb konnte nicht aktualisiert werden.');
                var s = json.selection.selected;
                showResult(
                    '<strong>Im Warenkorb:</strong> ' + data.quantity + ' × ' + data.length + ' mm' +
                    '<br>Verwendete Lager-Variante: ' + escapeHtml(s.variationNumber) + ' (ID ' + s.variationId + ')',
                    false
                );
                addButton.classList.add('d-none');

                if (window.ceresStore && window.ceresStore.dispatch) {
                    try { window.ceresStore.dispatch('loadBasketData'); } catch (e) {}
                }
            })
            .catch(function (error) {
                showResult(escapeHtml(error.message), true);
            })
            .then(function () {
                addButton.disabled = false;
                addButton.textContent = 'Wunschlänge in den Warenkorb';
            });
    }

    checkButton.addEventListener('click', resolveSelection);
    addButton.addEventListener('click', addToBasket);

    lengthInput.addEventListener('input', function () {
        addButton.classList.add('d-none');
        resultBox.classList.add('d-none');
    });

    setVisible(false);
    hideDiagnostic();
    checkEligibility(true);

    // Mehrere Event-Namen als toleranter Listener. Themes können Variantenwechsel
    // unterschiedlich weiterreichen. Zusätzlich läuft ein leichter Polling-Fallback.
    ['onVariationChanged', 'variationChanged', 'onVariationSelect'].forEach(function (eventName) {
        document.addEventListener(eventName, function () {
            window.setTimeout(function () { checkEligibility(true); }, 80);
        });
    });

    window.setInterval(function () {
        checkEligibility(false);
    }, 750);
})();
</script>
