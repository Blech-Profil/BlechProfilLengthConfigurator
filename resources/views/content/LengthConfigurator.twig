<div class="blechprofil-length-configurator card mb-3"
     data-blechprofil-length-configurator
     data-context-item-id="{{ contextItemId }}"
     data-context-variation-id="{{ contextVariationId }}"
     data-min-length="{{ minLength }}"
     data-max-length="{{ maxLength }}"
     data-saw-kerf="{{ sawKerf }}">
    <div class="card-body">
        <strong class="d-block mb-2">Wunschlänge konfigurieren</strong>

        <div class="form-row align-items-end">
            <div class="form-group col-sm-7 mb-2">
                <label>Wunschlänge in mm</label>
                <input
                    class="form-control"
                    type="number"
                    min="{{ minLength }}"
                    max="{{ maxLength }}"
                    step="1"
                    placeholder="z. B. 1268"
                    data-bp-length-input>
                <small class="form-text text-muted">{{ minLength }} bis {{ maxLength }} mm, Sägeschnitt aktuell {{ sawKerf }} mm.</small>
            </div>

            <div class="form-group col-sm-5 mb-2">
                <label>Menge</label>
                <input
                    class="form-control"
                    type="number"
                    min="1"
                    step="1"
                    value="1"
                    data-bp-quantity-input>
            </div>
        </div>

        <button type="button" class="btn btn-outline-secondary btn-block mb-2" data-bp-check-button>
            Passende Lagerlänge prüfen
        </button>

        <div class="alert alert-light border mb-2 d-none" data-bp-result></div>

        <button type="button" class="btn btn-primary btn-block d-none" data-bp-add-button>
            Wunschlänge in den Warenkorb
        </button>

        <small class="d-block text-muted mt-2" data-bp-debug>
            Alpha 0.1.7 · Variantenstamm freigegeben · {{ contextVariationNumber }} · Artikel-ID {{ contextItemId }} · Varianten-ID {{ contextVariationId }}
        </small>
    </div>
</div>

<script>
(function () {
    var root = document.currentScript ? document.currentScript.previousElementSibling : null;
    if (!root || !root.hasAttribute('data-blechprofil-length-configurator')) {
        var roots = document.querySelectorAll('[data-blechprofil-length-configurator]');
        root = roots.length ? roots[roots.length - 1] : null;
    }
    if (!root) return;

    function toInt(value) {
        var parsed = parseInt(value || '0', 10);
        return isNaN(parsed) ? 0 : parsed;
    }

    function parseIdsFromPath() {
        var match = window.location.pathname.match(/_(\d+)_(\d+)(?:\/)?$/);
        return match ? { itemId: toInt(match[1]), variationId: toInt(match[2]) } : { itemId: 0, variationId: 0 };
    }

    function resolveIds() {
        var pathIds = parseIdsFromPath();
        return {
            itemId: pathIds.itemId || toInt(root.getAttribute('data-context-item-id')),
            variationId: pathIds.variationId || toInt(root.getAttribute('data-context-variation-id'))
        };
    }

    var ids = resolveIds();
    root.setAttribute('data-item-id', String(ids.itemId));
    root.setAttribute('data-variation-id', String(ids.variationId));

    if (root.getAttribute('data-bp-booted') === '1') return;
    root.setAttribute('data-bp-booted', '1');

    var lengthInput = root.querySelector('[data-bp-length-input]');
    var quantityInput = root.querySelector('[data-bp-quantity-input]');
    var checkButton = root.querySelector('[data-bp-check-button]');
    var addButton = root.querySelector('[data-bp-add-button]');
    var resultBox = root.querySelector('[data-bp-result]');

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function showResult(html, isError) {
        resultBox.classList.remove('d-none', 'alert-light', 'alert-danger', 'alert-success');
        resultBox.classList.add(isError ? 'alert-danger' : 'alert-success');
        resultBox.innerHTML = html;
    }

    function values() {
        var currentIds = resolveIds();
        root.setAttribute('data-item-id', String(currentIds.itemId));
        root.setAttribute('data-variation-id', String(currentIds.variationId));

        return {
            itemId: currentIds.itemId,
            variationId: currentIds.variationId,
            length: toInt(lengthInput.value),
            quantity: parseFloat(quantityInput.value || '1')
        };
    }

    function resolveSelection() {
        var data = values();
        addButton.classList.add('d-none');

        if (!data.itemId || !data.variationId) {
            showResult('Artikel- oder Varianten-ID konnte nicht aus der URL ermittelt werden.', true);
            return;
        }

        if (!data.length || data.length < 1) {
            showResult('Bitte eine gültige Wunschlänge eingeben.', true);
            return;
        }

        checkButton.disabled = true;
        checkButton.textContent = 'Prüfung läuft …';

        var query = new URLSearchParams({
            itemId: String(data.itemId),
            variationId: String(data.variationId),
            length: String(data.length),
            quantity: String(data.quantity)
        });

        fetch('/blechprofil-length-configurator/resolve?' + query.toString(), {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
        })
            .then(function (response) {
                return response.json().then(function (json) {
                    if (!response.ok || !json.success) {
                        throw new Error(json.message || 'Keine passende Lagerlänge gefunden.');
                    }
                    return json;
                });
            })
            .then(function (json) {
                var s = json.selected;
                showResult(
                    '<strong>Ausgangsvariante:</strong> ' + escapeHtml(json.sourceVariationNumber) +
                    ' (ID ' + json.sourceVariationId + ')' +
                    '<br><strong>Passende Lagerlänge:</strong> ' + escapeHtml(s.variationNumber) +
                    ' (ID ' + s.variationId + ')' +
                    '<br>Rohlänge: ' + s.rawLength + ' mm' +
                    '<br>Verkaufbar: ja' +
                    '<br>Rechnerischer Rest je Stück: ' + s.restPerPiece + ' mm',
                    false
                );
                addButton.classList.remove('d-none');
            })
            .catch(function (error) {
                showResult(escapeHtml(error.message), true);
            })
            .then(function () {
                checkButton.disabled = false;
                checkButton.textContent = 'Passende Lagerlänge prüfen';
            });
    }

    function addToBasket() {
        var data = values();
        addButton.disabled = true;
        addButton.textContent = 'Wird hinzugefügt …';

        var form = new URLSearchParams();
        form.append('itemId', String(data.itemId));
        form.append('variationId', String(data.variationId));
        form.append('length', String(data.length));
        form.append('quantity', String(data.quantity));

        fetch('/blechprofil-length-configurator/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
            },
            body: form.toString()
        })
            .then(function (response) {
                return response.json().then(function (json) {
                    if (!response.ok || !json.success) {
                        throw new Error(json.message || 'Warenkorb konnte nicht aktualisiert werden.');
                    }
                    return json;
                });
            })
            .then(function (json) {
                var s = json.selection.selected;
                showResult(
                    '<strong>Im Warenkorb:</strong> ' + data.quantity + ' × ' + data.length + ' mm' +
                    '<br>Verwendete Lager-Variante: ' + escapeHtml(s.variationNumber) + ' (ID ' + s.variationId + ')',
                    false
                );
                addButton.classList.add('d-none');

                if (window.ceresStore && window.ceresStore.dispatch) {
                    try { window.ceresStore.dispatch('loadBasketData'); } catch (e) {}
                }
            })
            .catch(function (error) {
                showResult(escapeHtml(error.message), true);
            })
            .then(function () {
                addButton.disabled = false;
                addButton.textContent = 'Wunschlänge in den Warenkorb';
            });
    }

    checkButton.addEventListener('click', resolveSelection);
    addButton.addEventListener('click', addToBasket);

    lengthInput.addEventListener('input', function () {
        addButton.classList.add('d-none');
        resultBox.classList.add('d-none');
    });
})();
</script>
